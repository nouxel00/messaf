# Copier ce fichier en .env.local et adapter les valeurs.
# Aucun secret ne doit figurer ici : le portail est un client public.

# Source des données : "demo" (données fictives locales) ou "api" (API d'administration d'Axel)
VITE_DATA_SOURCE=demo

# Mode d'authentification : "demo" (accès fictif) ou "keycloak"
VITE_AUTH_MODE=demo

# URL de base de l'API d'administration (utilisée quand VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8000

# Keycloak (utilisé quand VITE_AUTH_MODE=keycloak) — valeurs à confirmer avec Axel
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=messaf
VITE_KEYCLOAK_CLIENT_ID=portail
